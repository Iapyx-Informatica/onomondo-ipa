-- also be reset when refreshFlag == true (behavioral; see proc_euicc_pkg_dwnld_exec.c).
-- TODO v1.1: rename es10b_enable_using_dd.c -> es10b_immediate_enable.c;
-- update libipa call sites and context.h state.
