# Build asn1c from master (post-0.9.28) for regeneration and cross-version testing.
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
      autoconf automake libtool bison flex make gcc g++ libc6-dev \
      ca-certificates git patch \
 && rm -rf /var/lib/apt/lists/*

# Clone and build at latest master HEAD (the old pinned commit was stale
# and didn't exist).  No configure in the repo, so run autoreconf.
RUN git clone --depth 1 https://github.com/vlm/asn1c.git /tmp/asn1c \
 && cd /tmp/asn1c \
 && autoreconf -iv \
 && ./configure --prefix=/usr/local --disable-shared --without-ubsan \
 && make -j"$(nproc)" \
 && make install \
 && rm -rf /tmp/asn1c

# Quick sanity check
RUN asn1c -version 2>&1 | head -1

WORKDIR /src
